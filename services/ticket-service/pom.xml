<?xml version="1.0" encoding="UTF-8"?>
<!-- Modulo propietario del ciclo de vida de los tickets. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Hereda versiones y plugins sin duplicarlos en este servicio. -->
    <parent>
        <groupId>com.supporthub</groupId>
        <artifactId>supporthub</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>ticket-service</artifactId>
    <dependencies>
        <!-- Valida OpenAPI solo durante pruebas; no agrega Swagger al servicio productivo. -->
        <dependency>
            <groupId>io.swagger.parser.v3</groupId>
            <artifactId>swagger-parser-v3</artifactId>
            <version>2.1.27</version>
            <scope>test</scope>
        </dependency>
        <!-- Solo se incorpora al entorno de pruebas, no al artefacto productivo. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <!-- Copia el contrato real al classpath de pruebas para evitar rutas dependientes del cwd. -->
        <testResources>
            <testResource>
                <directory>../../contracts</directory>
                <targetPath>contracts</targetPath>
                <includes><include>openapi.yaml</include></includes>
            </testResource>
        </testResources>
    </build>
</project>
